# Copy this file to .env.prod and fill in the PRODUCTION Supabase project's connection strings.
# .env.prod is gitignored and should never be committed.
#
# Used ONLY by `npm run db:migrate:prod` to apply migrations to production as a release step (see
# RELEASING.md) -- the app itself never reads this file, and it's not used by npm run dev/build/start.

# Production Supabase project -> Connect -> Transaction pooler (port 6543).
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# Production Supabase project -> Connect -> Session pooler (port 5432). Needed by drizzle-kit for
# the same reason .env.local's DATABASE_URL_MIGRATIONS is -- transaction-mode pooling doesn't
# support the session-level features migrations need.
DATABASE_URL_MIGRATIONS="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
