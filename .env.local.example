# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored and should never be committed.

# Local Docker Postgres (npm run db:up) -- use this for both variables below during development:
# DATABASE_URL="postgresql://postgres:postgres@localhost:54322/expense_tracker"
# DATABASE_URL_MIGRATIONS="postgresql://postgres:postgres@localhost:54322/expense_tracker"

# Supabase project -> Connect -> Transaction pooler (port 6543). Used by the app at runtime.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# Supabase project -> Connect -> Session pooler (port 5432). Used only by drizzle-kit for migrations,
# since transaction-mode pooling doesn't support the session-level features migrations need.
DATABASE_URL_MIGRATIONS="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="[generate-your-own]"

# Optional: standing demo account for browser-testing/screenshots (see db:seed-demo). Not required
# for normal development.
DEMO_ACCOUNT_EMAIL="demo@example.com"
DEMO_ACCOUNT_PASSWORD="[generate-your-own]"

# Resend (resend.com) -- sends "reset your password" emails. Get an API key from the Resend
# dashboard. RESEND_FROM_EMAIL must be on a domain verified in Resend; until you've verified one,
# use Resend's sandbox sender "onboarding@resend.dev" (only delivers to your own Resend account email).
RESEND_API_KEY="[your-resend-api-key]"
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Protects /api/cron/purge-guests (daily guest-account cleanup, see vercel.json). Vercel Cron sends it
# as a bearer token. Only needed on Vercel's Production environment -- crons don't run on previews
# or locally -- but set it locally too if you want to try the endpoint by hand.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CRON_SECRET="[generate-your-own]"

# Optional: origin used in emailed links (password reset, email verification), e.g. https://example.com.
# When unset, Vercel's own system variables are used; locally the request's Host header is used.
# APP_URL="http://localhost:3000"
